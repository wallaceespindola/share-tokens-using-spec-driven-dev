@startuml handoff-sequence
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam dpi 200
hide footbox
skinparam sequence {
  ArrowColor #0d1b3e
  LifeLineBorderColor #6b7a90
  ParticipantBorderColor #0d1b3e
  ParticipantBackgroundColor #d9f5f2
  ActorBorderColor #0d1b3e
  ActorBackgroundColor #d9f5f2
}
actor Business
participant "Owner\n(no / low credits)" as Owner
participant "Reviewer" as Reviewer #fff3d6
participant "Delegate\n(spare Copilot)" as Delegate #dfe7fb
participant "Repo + CI/CD" as Repo #f1f3f6

Business -> Owner : requirements + acceptance criteria
Owner -> Repo : commit TASK-042.md, open ai-delegation issue
Owner -> Reviewer : request review
Reviewer --> Owner : approved (definition of ready)
Owner -> Delegate : assign task
note over Delegate : fresh Copilot session\nplan, implement, test\nfill implementation notes
Delegate -> Repo : hand back branch, all tests green
Owner -> Repo : validate, fix small issues
Owner -> Repo : final commit + pull request
Repo --> Owner : build, tests, scans, quality gates
@enduml
